<Window x:Class="VisionWeave.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:design="clr-namespace:VisionWeave.App.Design"
        xmlns:nodify="https://miroiu.github.io/nodify"
        xmlns:preview="clr-namespace:VisionWeave.App.Preview"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        d:DataContext="{x:Static design:ShellDesignData.ViewModel}"
        Title="{Binding WindowTitle}"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="600"
        Background="{DynamicResource Brush.Background.Canvas}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O"
                    Command="{Binding OpenCommand}"
                    Modifiers="Control" />
        <KeyBinding Key="S"
                    Command="{Binding SaveCommand}"
                    Modifiers="Control" />
        <KeyBinding Key="R"
                    Command="{Binding RunWorkflow.Command}"
                    Modifiers="Control" />
        <KeyBinding Key="Z"
                    Command="{Binding Canvas.UndoCommand}"
                    Modifiers="Control" />
        <KeyBinding Key="Y"
                    Command="{Binding Canvas.RedoCommand}"
                    Modifiers="Control" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- What this is, what can be done to the document, and what the last run did. -->
        <Border x:Name="TopBarRegion"
                Grid.Row="0"
                Padding="16,10"
                Background="{DynamicResource Brush.Background.Surface}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Text="VisionWeave" />
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Text="Visual image-processing workflows" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="32,0,0,0"
                            Orientation="Horizontal">
                    <ui:Button Command="{Binding OpenCommand}"
                               Content="_Open"
                               Icon="{ui:SymbolIcon Symbol=FolderOpen20}"
                               Style="{StaticResource Shell.CommandButton}"
                               ToolTip="Open a workflow document (Ctrl+O)" />
                    <ui:Button Command="{Binding SaveCommand}"
                               Content="_Save"
                               Icon="{ui:SymbolIcon Symbol=Save20}"
                               Style="{StaticResource Shell.CommandButton}"
                               ToolTip="Write the document to its file (Ctrl+S)" />

                    <Border Width="1"
                            Margin="8,4,14,4"
                            Background="{DynamicResource Brush.Border.Subtle}" />

                    <ui:Button Command="{Binding Canvas.UndoCommand}"
                               Content="_Undo"
                               Icon="{ui:SymbolIcon Symbol=ArrowLeft20}"
                               Style="{StaticResource Shell.CommandButton}"
                               ToolTip="Undo the last edit (Ctrl+Z)" />
                    <ui:Button Command="{Binding Canvas.RedoCommand}"
                               Content="_Redo"
                               Icon="{ui:SymbolIcon Symbol=ArrowRight20}"
                               Style="{StaticResource Shell.CommandButton}"
                               ToolTip="Redo the last undone edit (Ctrl+Y)" />

                    <!--
                        Running and stopping are the two gestures over one running
                        state: the Run action is disabled while a run is executing,
                        and Stop is enabled exactly while there is one to stop.
                    -->
                    <Border Width="1"
                            Margin="8,4,14,4"
                            Background="{DynamicResource Brush.Border.Subtle}" />

                    <ui:Button Appearance="Primary"
                               Command="{Binding RunWorkflow.Command}"
                               Content="_Run"
                               Icon="{ui:SymbolIcon Symbol=Play20}"
                               Style="{StaticResource Shell.CommandButton}"
                               ToolTip="Run the workflow and show the newest image it produces (Ctrl+R)" />
                    <ui:Button Command="{Binding RunWorkflow.CancelCommand}"
                               Content="_Stop"
                               Icon="{ui:SymbolIcon Symbol=Stop20}"
                               Style="{StaticResource Shell.CommandButton}"
                               ToolTip="Stop the run. Everything the run already produced is kept." />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource Shell.StatusFieldLabel}"
                               Text="Run state" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource Shell.StatusFieldValue}"
                               Text="{Binding Status.RunOutcome}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- The work surface: the catalogue that names what exists, the surface the
             document is edited on, and the inspector that describes the selection. -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border x:Name="NodeCatalogueRegion"
                    Grid.Column="0"
                    Style="{StaticResource Shell.RegionSurface}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource Shell.RegionHeader}"
                               Text="Node catalogue" />
                    <!--
                        The search filters what exists rather than changing it, so it
                        is a query over the catalog and never an edit of anything.
                    -->
                    <Grid DockPanel.Dock="Top" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Margin="8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Symbol="Search20" />
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource Shell.InputField}"
                                 Text="{Binding CatalogueSearch, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search by node name or identifier" />
                    </Grid>
                    <!--
                        The tag row is the catalogue's second axis: a category says
                        where a type sits in the library, and a tag cuts across the
                        groups to say what it does. Choosing a chip narrows the list
                        beside the search rather than replacing it, so the two are read
                        as one filter with two parts, and the row is hidden entirely by
                        a catalog whose definitions carry no tags.
                    -->
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTags}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding CatalogueTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Choosing a chip is the filter's one gesture: it
                                         reaches the view model rather than filtering a
                                         copy the region keeps. -->
                                    <Button Command="{Binding DataContext.ToggleTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Tag}"
                                            Content="{Binding Label}"
                                            Style="{StaticResource Shell.CatalogueTag}"
                                            ToolTip="Show only the node types that carry this tag" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource Shell.RegionNote}"
                               Text="{Binding NodeCatalogSummary}" />
                    <TextBlock DockPanel.Dock="Bottom"
                               Style="{StaticResource Shell.RegionNote}"
                               Text="{Binding CatalogueNotice}" />
                    <ScrollViewer Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CatalogueGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Accent.Primary}"
                                                   Text="{Binding Category}" />
                                        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Entries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!--
                                                        Choosing a type is the catalogue's one
                                                        gesture: it reaches the canvas command
                                                        rather than editing anything here. A
                                                        document this build cannot write back
                                                        offers no addable type at all.
                                                    -->
                                                    <Button Margin="0,1"
                                                            Command="{Binding DataContext.Canvas.AddNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding TypeId}"
                                                            Content="{Binding}"
                                                            IsEnabled="{Binding DataContext.Canvas.IsEditable, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Style="{StaticResource Shell.CatalogueEntry}"
                                                            ToolTip="Add this node type to the middle of the canvas">
                                                        <Button.ContentTemplate>
                                                            <DataTemplate>
                                                                <!-- The words the type carries sit
                                                                     beside the name it is shown under,
                                                                     so the filter row explains itself. -->
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding DisplayName}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Style="{StaticResource Shell.CatalogueEntryTags}"
                                                                               Text="{Binding TagLine}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </Button.ContentTemplate>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border x:Name="CanvasRegion"
                    Grid.Column="1"
                    Margin="12,0"
                    Padding="0"
                    Style="{StaticResource Shell.RegionSurface}">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="16,12"
                            Background="{DynamicResource Brush.Background.SurfaceRaised}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Shell.RegionHeader}" Text="{Binding DocumentTitle}" />
                                <TextBlock Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           Text="{Binding DocumentCounts}" />
                            </StackPanel>

                            <Button HorizontalAlignment="Right"
                                    Command="{Binding Canvas.DeleteSelectionCommand}"
                                    Content="_Delete"
                                    Style="{StaticResource Shell.ActionButton}"
                                    ToolTip="Delete the selected nodes and the wires attached to them (Delete)" />
                        </Grid>
                    </Border>

                    <!--
                        A document this build cannot write back is shown and not
                        edited, so the surface says why rather than leaving the user
                        to discover it from controls that do nothing.
                    -->
                    <Border DockPanel.Dock="Top">
                        <Border.Style>
                            <Style BasedOn="{StaticResource Shell.Notice}" TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{DynamicResource Brush.Text.Primary}"
                                   Text="{Binding ReadOnlyNote}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--
                            The work surface. Pan, zoom, and selection are the
                            editor's; everything the document decides arrives as a
                            projection, and every gesture leaves as a command.
                        -->
                        <nodify:NodifyEditor x:Name="WorkflowCanvas"
                                             Grid.Row="0"
                                             Background="{DynamicResource Brush.Background.Canvas}"
                                             ConnectionCompletedCommand="{Binding Canvas.ConnectCommand}"
                                             Connections="{Binding Canvas.Connectors}"
                                             ConnectionTemplate="{StaticResource Shell.CanvasConnectionTemplate}"
                                             ItemContainerStyle="{StaticResource Shell.CanvasNodeContainer}"
                                             ItemTemplate="{StaticResource Shell.CanvasNode}"
                                             ItemsDragCompletedCommand="{Binding Canvas.MoveCommand}"
                                             ItemsSource="{Binding Canvas.Nodes}"
                                             MaxViewportZoom="3"
                                             MinViewportZoom="0.2"
                                             PendingConnectionTemplate="{StaticResource Shell.CanvasPendingConnection}"
                                             RemoveConnectionCommand="{Binding Canvas.DisconnectCommand}"
                                             ViewportLocation="{Binding Canvas.ViewportLocation, Mode=OneWayToSource}"
                                             ViewportSize="{Binding Canvas.ViewportSize, Mode=OneWayToSource}">
                            <nodify:NodifyEditor.InputBindings>
                                <KeyBinding Key="Delete" Command="{Binding Canvas.DeleteSelectionCommand}" />
                            </nodify:NodifyEditor.InputBindings>
                        </nodify:NodifyEditor>

                        <!-- What to do while the document holds nothing to draw. -->
                        <TextBlock Grid.Row="0"
                                   MaxWidth="340"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Text="Choose a node type in the catalogue to place a node, then drag from one port to another to connect them."
                                   TextAlignment="Center">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource Shell.RegionNote}" TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Canvas.IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!--
                            What the last run produced: every image the node published,
                            the node that published them, and how many there are with
                            the shape and pixel layout they arrived with. The images are
                            copies, so they stay readable after the run that produced
                            them has ended and released every frame it held, and they are
                            drawn from below the work surface so the document keeps the
                            room it is edited in. A node with one image draws one tile
                            and needs no name for it; a node that split an image into
                            channels draws one tile per channel, each named, because
                            that name is what tells them apart.
                        -->
                        <Border x:Name="PreviewRegion"
                                Grid.Row="1"
                                Padding="16,12"
                                Background="{DynamicResource Brush.Background.SurfaceRaised}"
                                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                BorderThickness="0,1,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource Shell.RegionHeader}"
                                           Text="Preview" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource Shell.RegionNote}"
                                           Text="{Binding Preview.PreviewTitle}" />
                                <TextBlock DockPanel.Dock="Bottom"
                                           Style="{StaticResource Shell.RegionNote}"
                                           Text="{Binding Preview.PreviewDetail}" />

                                <!--
                                    Said while nothing has run, and taken away as soon
                                    as something has: an empty frame with no
                                    explanation would read as a preview that failed
                                    to draw.
                                -->
                                <TextBlock DockPanel.Dock="Top"
                                           Margin="0,4,0,0"
                                           Text="{Binding Preview.PreviewNotice}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource Shell.RegionNote}" TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Preview.HasPreview}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!--
                                    A node with several outputs scrolls rather than
                                    growing without bound, so the work surface above
                                    keeps the room it is edited in.
                                -->
                                <ScrollViewer Margin="0,8,0,0"
                                              MaxHeight="320"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Preview.Images}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="preview:PreviewImage">
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Margin="0,0,0,2"
                                                               Style="{StaticResource Shell.RegionNote}"
                                                               Text="{Binding Label}"
                                                               Visibility="{Binding ShowsLabel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <preview:PreviewImageButton Padding="0"
                                                                                HorizontalAlignment="Left"
                                                                                Background="Transparent"
                                                                                BorderThickness="0"
                                                                                Cursor="Hand"
                                                                                ImageSource="{Binding Image}"
                                                                                ImageTitle="{Binding Caption}"
                                                                                ToolTip="Open the image at full size">
                                                        <Image MaxHeight="200"
                                                               Source="{Binding Image}"
                                                               Stretch="Uniform" />
                                                    </preview:PreviewImageButton>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <Border x:Name="InspectorRegion"
                    Grid.Column="2"
                    Style="{StaticResource Shell.RegionSurface}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource Shell.RegionHeader}"
                               Text="Inspector" />
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource Shell.InspectorTitle}"
                               Text="{Binding Inspector.NodeTitle}" />
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource Shell.RegionNote}"
                               Text="{Binding Inspector.NodeCaption}" />

                    <!-- What a document this build cannot write back holds still, and
                         why nothing here can be edited. -->
                    <Border DockPanel.Dock="Top">
                        <Border.Style>
                            <Style BasedOn="{StaticResource Shell.Notice}" TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{DynamicResource Brush.Text.Primary}"
                                   Text="{Binding ReadOnlyNote}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <TextBlock DockPanel.Dock="Bottom"
                               Style="{StaticResource Shell.RegionNote}"
                               Text="{Binding SelectionSummary}" />
                    <TextBlock DockPanel.Dock="Bottom"
                               Style="{StaticResource Shell.RegionNote}"
                               Text="{Binding SelectionConditionSummary}" />
                    <TextBlock DockPanel.Dock="Bottom"
                               Margin="0,12,0,0"
                               Style="{StaticResource Shell.RegionHeader}"
                               Text="{Binding Inspector.DiagnosticCountText}" />

                    <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!--
                                One field per parameter the definition declares. The
                                field reports what the user committed; the inspector
                                command turns it into a document command, so nothing
                                here edits the document itself.
                            -->
                            <ItemsControl IsEnabled="{Binding Inspector.IsEditable}"
                                          ItemsSource="{Binding Inspector.Parameters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Style="{StaticResource Shell.ParameterRow}"
                                              ToolTip="{Binding Summary}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Margin="0,0,10,0"
                                                       Style="{StaticResource Shell.FieldLabel}"
                                                       Text="{Binding DisplayName}" />

                                            <Grid Grid.Column="1">
                                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}">
                                                    <!--
                                                        Typing a value is not a whole gesture
                                                        the way toggling a switch is, so the
                                                        field says how the text it holds is
                                                        applied. The binding resolves against
                                                        the templated item, which is the field
                                                        itself.
                                                    -->
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Command="{Binding ApplyCommand}" Key="Enter" />
                                                    </TextBox.InputBindings>
                                                    <TextBox.Style>
                                                        <Style BasedOn="{StaticResource Shell.InputField}" TargetType="TextBox">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsText}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>

                                                <ui:NumberBox Maximum="{Binding Maximum}"
                                                              Minimum="{Binding Minimum}"
                                                              SmallChange="{Binding SmallChange}"
                                                              Value="{Binding NumericValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <ui:NumberBox.Style>
                                                        <Style BasedOn="{StaticResource {x:Type ui:NumberBox}}"
                                                               TargetType="ui:NumberBox">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNumeric}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:NumberBox.Style>
                                                </ui:NumberBox>

                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPath}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Style="{StaticResource Shell.InputField}"
                                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Command="{Binding ApplyCommand}" Key="Enter" />
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                    <Button Grid.Column="1"
                                                            Margin="6,0,0,0"
                                                            Command="{Binding BrowseCommand}"
                                                            Style="{StaticResource Shell.FieldIconButton}"
                                                            ToolTip="Browse for a location">
                                                        <ui:SymbolIcon Symbol="FolderOpen20" />
                                                    </Button>
                                                </Grid>

                                                <ui:ToggleSwitch HorizontalAlignment="Right"
                                                                 IsChecked="{Binding IsChecked}">
                                                    <ui:ToggleSwitch.Style>
                                                        <Style TargetType="ui:ToggleSwitch">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:ToggleSwitch.Style>
                                                </ui:ToggleSwitch>

                                                <ComboBox ItemsSource="{Binding Options}"
                                                          SelectedItem="{Binding SelectedOption}"
                                                          Visibility="{Binding HasOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>

                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Style="{StaticResource Shell.FieldCondition}"
                                                       Text="{Binding Condition}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource Shell.RegionNote}"
                                       Text="{Binding Inspector.ParameterNote}" />

                            <!--
                                Every condition the selection carries, each naming the
                                element it points at, so a marked node and a marked
                                parameter are told apart without reading the message.
                            -->
                            <ItemsControl ItemsSource="{Binding Inspector.Diagnostics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Shell.DiagnosticRow}"
                                                ToolTip="{Binding Summary}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Shell.FieldCondition}"
                                                           Text="{Binding SeverityWord}" />
                                                <TextBlock Foreground="{DynamicResource Brush.Text.Primary}"
                                                           Text="{Binding Code}" />
                                                <TextBlock Style="{StaticResource Shell.RegionNote}"
                                                           Text="{Binding Message}" />
                                                <TextBlock Style="{StaticResource Shell.RegionNote}"
                                                           Text="{Binding Target}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Durable state, in contrast to the transient snackbar below. The severity
             is named in the text as well as coloured, so it reads without colour. -->
        <Border x:Name="StatusRegion"
                Grid.Row="2"
                Padding="16,8"
                Background="{DynamicResource Brush.Background.Surface}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource Shell.StatusFieldLabel}"
                           Text="Document" />
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource Shell.StatusFieldValue}"
                           Text="{Binding Status.DocumentState}" />

                <Border Style="{StaticResource Shell.StatusFieldSeparator}" />

                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource Shell.StatusFieldLabel}"
                           Text="Operation" />
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource Shell.StatusFieldValue}"
                           Text="{Binding Status.BackgroundOperation}" />

                <Border Style="{StaticResource Shell.StatusFieldSeparator}" />

                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource Shell.StatusFieldLabel}"
                           Text="Run" />
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource Shell.StatusFieldValue}"
                           Text="{Binding Status.RunOutcome}" />

                <Border Style="{StaticResource Shell.StatusFieldSeparator}" />

                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource Shell.StatusFieldLabel}"
                           Text="Condition" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Status.Condition}">
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource Shell.StatusFieldValue}" TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status.ConditionSeverity}" Value="Error">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.State.Danger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status.ConditionSeverity}" Value="Warning">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.State.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status.ConditionSeverity}" Value="Information">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.State.Info}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Where a condition the presenter announces is drawn. -->
        <ui:SnackbarPresenter x:Name="SnackbarHost"
                              Grid.Row="0"
                              Grid.RowSpan="3"
                              Margin="0,0,24,24"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom" />

        <!--
            A question about the document, asked over the work surface rather than in
            a window of its own. The scrim dims the shell so the question reads as
            the thing to answer, and the card is opaque on top of it.
        -->
        <Grid x:Name="PromptOverlay"
              Grid.Row="0"
              Grid.RowSpan="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Prompt.IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{DynamicResource Brush.Background.Canvas}" Opacity="0.85" />

            <Border Style="{StaticResource Shell.PromptCard}">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource Brush.Text.Primary}"
                               Text="{Binding Prompt.Question}"
                               TextWrapping="Wrap" />

                    <StackPanel Margin="0,16,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Command="{Binding Prompt.AcceptCommand}"
                                Content="{Binding Prompt.AcceptText}"
                                Style="{StaticResource Shell.ActionButton}" />
                        <Button Margin="8,0,0,0"
                                Command="{Binding Prompt.RefuseCommand}"
                                Content="{Binding Prompt.RefuseText}"
                                Style="{StaticResource Shell.ActionButton}" />
                        <Button Margin="8,0,0,0"
                                Command="{Binding Prompt.DismissCommand}"
                                Content="{Binding Prompt.CancelText}"
                                Style="{StaticResource Shell.ActionButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
