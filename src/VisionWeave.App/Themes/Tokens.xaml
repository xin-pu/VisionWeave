<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The semantic design tokens of the dark-amber visual system recorded in
        docs/design/pre-ui-hardening-and-visual-direction.md.

        A token names what a value means, never where it is used, so a later light
        or high-contrast theme replaces the values in this file and no control
        template changes. This is the only file in the shell that may carry a
        colour literal; every other dictionary and view refers to a token by name.
    -->

    <Color x:Key="Color.Background.Canvas">#FF111315</Color>
    <Color x:Key="Color.Background.Surface">#FF1A1D20</Color>
    <Color x:Key="Color.Background.SurfaceRaised">#FF24282D</Color>

    <Color x:Key="Color.Border.Subtle">#FF363B42</Color>

    <Color x:Key="Color.Text.Primary">#FFF5F2EA</Color>
    <Color x:Key="Color.Text.Secondary">#FFB9B5AC</Color>

    <!--
        Text painted on an accent surface. The plan's table does not name this
        token; the shell needs it because the accent is also a control surface,
        and it must stay legible there in every theme.
    -->
    <Color x:Key="Color.Text.OnAccent">#FF111315</Color>

    <Color x:Key="Color.Accent.Primary">#FFF6B73C</Color>
    <Color x:Key="Color.Accent.Hover">#FFFFD166</Color>
    <Color x:Key="Color.Accent.Pressed">#FFD99717</Color>

    <Color x:Key="Color.State.Success">#FF69C48B</Color>
    <Color x:Key="Color.State.Warning">#FFF6B73C</Color>
    <Color x:Key="Color.State.Danger">#FFFF7070</Color>
    <Color x:Key="Color.State.Info">#FF79B8FF</Color>

    <!-- One brush per token, so a template binds a brush and reads the colour. -->
    <SolidColorBrush x:Key="Brush.Background.Canvas" Color="{StaticResource Color.Background.Canvas}" />
    <SolidColorBrush x:Key="Brush.Background.Surface" Color="{StaticResource Color.Background.Surface}" />
    <SolidColorBrush x:Key="Brush.Background.SurfaceRaised" Color="{StaticResource Color.Background.SurfaceRaised}" />
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Border.Subtle}" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{StaticResource Color.Text.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Accent.Primary" Color="{StaticResource Color.Accent.Primary}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="Brush.State.Success" Color="{StaticResource Color.State.Success}" />
    <SolidColorBrush x:Key="Brush.State.Warning" Color="{StaticResource Color.State.Warning}" />
    <SolidColorBrush x:Key="Brush.State.Danger" Color="{StaticResource Color.State.Danger}" />
    <SolidColorBrush x:Key="Brush.State.Info" Color="{StaticResource Color.State.Info}" />

    <!--
        The WPF UI theme paints its own surfaces and text from these keys. Aliasing
        them onto the tokens lets framework controls join the palette without a
        control template of ours changing, which is the point of a semantic token.
    -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource Color.Background.Canvas}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource Color.Border.Subtle}" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource Color.Background.SurfaceRaised}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource Color.Accent.Primary}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource Color.Text.OnAccent}" />

</ResourceDictionary>
