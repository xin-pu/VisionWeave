<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The shell's styles. Every value comes from Themes/Tokens.xaml, so this file
        carries meaning and no colour of its own.
    -->

    <!--
        Keyboard focus. The accent ring is the one place the shell says where the
        keyboard is, so the theme test holds it to the non-text contrast ratio the
        dark-amber direction requires of a focus indicator.
    -->
    <Style x:Key="Shell.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2"
                               RadiusX="4"
                               RadiusY="4"
                               SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Brush.Accent.Primary}"
                               StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One pane, card, or surface of the shell. -->
    <Style x:Key="Shell.RegionSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- The title of a region, which names what the region holds. -->
    <Style x:Key="Shell.RegionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <!-- Supporting text inside a region, including what a later package adds. -->
    <Style x:Key="Shell.RegionNote" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <!-- A field name in the status area. -->
    <Style x:Key="Shell.StatusFieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- A field value in the status area, readable without colour. -->
    <Style x:Key="Shell.StatusFieldValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- The separator between two status fields. -->
    <Style x:Key="Shell.StatusFieldSeparator" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="16,2" />
        <Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}" />
    </Style>

    <!-- The shell's one action control, so a command looks the same wherever it is. -->
    <Style x:Key="Shell.ActionButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Accent.Pressed}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
