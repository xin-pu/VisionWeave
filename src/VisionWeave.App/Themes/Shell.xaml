<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nodify="https://miroiu.github.io/nodify"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        The shell's styles. Every value comes from Themes/Tokens.xaml, so this file
        carries meaning and no colour of its own.
    -->

    <!--
        Keyboard focus. The accent ring is the one place the shell says where the
        keyboard is, so the theme test holds it to the non-text contrast ratio the
        dark-amber direction requires of a focus indicator.
    -->
    <Style x:Key="Shell.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2"
                               RadiusX="4"
                               RadiusY="4"
                               SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Brush.Accent.Primary}"
                               StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One pane, card, or surface of the shell. -->
    <Style x:Key="Shell.RegionSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- The title of a region, which names what the region holds. -->
    <Style x:Key="Shell.RegionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <!-- Supporting text inside a region, including what a later package adds. -->
    <Style x:Key="Shell.RegionNote" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <!-- A field name in the status area. -->
    <Style x:Key="Shell.StatusFieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- A field value in the status area, readable without colour. -->
    <Style x:Key="Shell.StatusFieldValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- The separator between two status fields. -->
    <Style x:Key="Shell.StatusFieldSeparator" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="16,2" />
        <Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}" />
    </Style>

    <!-- The shell's one action control, so a command looks the same wherever it is. -->
    <Style x:Key="Shell.ActionButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Accent.Pressed}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A compact, icon-led command in the application toolbar. -->
    <Style x:Key="Shell.CommandButton"
           BasedOn="{StaticResource {x:Type ui:Button}}"
           TargetType="ui:Button">
        <Setter Property="Width" Value="88" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.FocusVisual}" />
    </Style>

    <!--
        A small icon-only action attached to an input field. It wears the shell's own
        template rather than the framework button's, because this control is drawn from
        the inspector's item template: an element generated by a data template is
        templated by its item container, and the framework button's pressed state resolves
        its own foreground and background through that parent, so its pressed look would
        silently never apply.
    -->
    <Style x:Key="Shell.FieldIconButton"
           BasedOn="{StaticResource Shell.ActionButton}"
           TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
        The canvas surface. A node is a card that says what it is, which ports it
        has, and what condition it owns; a wire is a line whose colour only repeats
        what the wire's own label and the status area already say. Every value comes
        from the token dictionary, so the canvas is themed by the same file as the
        rest of the shell.
    -->

    <!--
        A placed node. The container owns where the node sits and whether it is
        selected, so both travel back to the projection: the position is what a
        completed drag commits, and the selection is what the shell reports.
    -->
    <Style x:Key="Shell.CanvasNodeContainer" TargetType="nodify:ItemContainer">
        <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="SelectedBrush" Value="{DynamicResource Brush.Accent.Primary}" />
        <Setter Property="SelectedBorderThickness" Value="2" />
        <Setter Property="HighlightBrush" Value="{DynamicResource Brush.Accent.Hover}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.FocusVisual}" />
    </Style>

    <!--
        A port. Nodify stops publishing a connector's anchor once IsConnected is
        false, and its default is false, so a connector left at the default would
        keep the point it started at while its node moved and every wire would hang
        in the wrong place.
    -->
    <Style x:Key="Shell.CanvasConnector" TargetType="nodify:Connector">
        <Setter Property="IsConnected" Value="True" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Background.Canvas}" />
        <Setter Property="Cursor" Value="Cross" />
        <Setter Property="ToolTip" Value="{Binding Summary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.FocusVisual}" />
        <!--
            Nodify's stock connector has no guaranteed visible chrome under every
            host theme. Draw the port in the required PART_Connector element so a
            connection endpoint is always discoverable and remains interactive.
        -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="nodify:Connector">
                    <Ellipse x:Name="PART_Connector"
                             Fill="{TemplateBinding Background}"
                             SnapsToDevicePixels="True"
                             Stroke="{TemplateBinding BorderBrush}"
                             StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Brush.State.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Error">
                <Setter Property="Background" Value="{DynamicResource Brush.State.Danger}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Information">
                <Setter Property="Background" Value="{DynamicResource Brush.State.Info}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A port that receives a value. -->
    <DataTemplate x:Key="Shell.CanvasPortInput">
        <StackPanel Margin="0,2" Orientation="Horizontal">
            <nodify:Connector Anchor="{Binding Anchor, Mode=OneWayToSource}" Style="{StaticResource Shell.CanvasConnector}" />
            <TextBlock Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Text="{Binding DisplayName}" />
        </StackPanel>
    </DataTemplate>

    <!-- A port that publishes a value. -->
    <DataTemplate x:Key="Shell.CanvasPortOutput">
        <StackPanel Margin="0,2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <TextBlock Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Text="{Binding DisplayName}" />
            <nodify:Connector Anchor="{Binding Anchor, Mode=OneWayToSource}" Style="{StaticResource Shell.CanvasConnector}" />
        </StackPanel>
    </DataTemplate>

    <!--
        A wire. The label in the middle of the line is the word for the condition,
        so a marked wire reads as marked without depending on its colour, and the
        pointer resting on it explains the condition in full.
    -->
    <Style x:Key="Shell.CanvasConnection" TargetType="nodify:LineConnection">
        <Setter Property="ArrowEnds" Value="End" />
        <Setter Property="ArrowSize" Value="8,6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="OutlineBrush" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="OutlineThickness" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Text" Value="{Binding SeverityWord}" />
        <Setter Property="TextBackground" Value="{DynamicResource Brush.Background.SurfaceRaised}" />
        <Setter Property="TextCornerRadius" Value="4" />
        <Setter Property="TextPadding" Value="5,1" />
        <Setter Property="ToolTip" Value="{Binding Summary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                <Setter Property="OutlineBrush" Value="{DynamicResource Brush.State.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Error">
                <Setter Property="OutlineBrush" Value="{DynamicResource Brush.State.Danger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A node: its title, the port it reads from, the port it publishes to, and its type. -->
    <DataTemplate x:Key="Shell.CanvasNode">
        <Border MinWidth="180"
                Background="{DynamicResource Brush.Background.SurfaceRaised}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="6"
                ToolTip="{Binding Summary}">
            <StackPanel>
                <Border Padding="10,6"
                        Background="{DynamicResource Brush.Background.Surface}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="6,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   Text="{Binding DisplayName}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Text="{Binding SeverityWord}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Information">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.State.Info}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.State.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.State.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Grid Margin="0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl Grid.Column="0"
                                  ItemTemplate="{StaticResource Shell.CanvasPortInput}"
                                  ItemsSource="{Binding Inputs}" />
                    <ItemsControl Grid.Column="1"
                                  ItemTemplate="{StaticResource Shell.CanvasPortOutput}"
                                  ItemsSource="{Binding Outputs}" />
                </Grid>

                <TextBlock Margin="10,0,10,8"
                           FontSize="11"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Text="{Binding Caption}"
                           TextTrimming="CharacterEllipsis" />

                <!--
                    What the newest run did to this node, stated in words so the mark
                    reads without its colour. The row is out of the way until a run
                    covers the node, and a node that was stopped or never started is
                    named as plainly as one that succeeded.
                -->
                <TextBlock Margin="10,0,10,8"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Text="{Binding RunDetail}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RunState}" Value="NotRun">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RunState}" Value="Blocked">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.State.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RunState}" Value="Cancelled">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.State.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RunState}" Value="Succeeded">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.State.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RunState}" Value="Failed">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.State.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- A wire between two placed ports. -->
    <DataTemplate x:Key="Shell.CanvasConnectionTemplate">
        <nodify:LineConnection Source="{Binding Source.Anchor}"
                               Style="{StaticResource Shell.CanvasConnection}"
                               Target="{Binding Target.Anchor}" />
    </DataTemplate>

    <!--
        The wire a drag is drawing. It is visual only: the document hears about the
        gesture when the drag completes, and a drag that is refused leaves the canvas
        exactly as it was. The editor draws it outside the nodes, where there is no
        node to take a data context from, so the template reads the connector the
        control published for itself rather than a context it does not have. A drag
        that started at an input is drawn backwards, so the curve follows the pointer
        whichever end it began at.
    -->
    <DataTemplate x:Key="Shell.CanvasPendingConnection">
        <nodify:PendingConnection Stroke="{DynamicResource Brush.Accent.Primary}"
                                  StrokeDashArray="4 2"
                                  StrokeThickness="2">
            <nodify:PendingConnection.Style>
                <Style TargetType="nodify:PendingConnection">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Source.Direction, RelativeSource={RelativeSource Self}}" Value="Input">
                            <Setter Property="Direction" Value="Backward" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </nodify:PendingConnection.Style>
        </nodify:PendingConnection>
    </DataTemplate>
    <!--
        One addable node type. It reads as a list entry rather than as an action,
        because the catalogue is a list the user picks from, and it keeps the focus
        ring and the pressed treatment of the shell's action control.
    -->
    <Style x:Key="Shell.CatalogueEntry"
           BasedOn="{StaticResource Shell.ActionButton}"
           TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <!--
            The entry spans the column so its name is trimmed rather than overflowing
            and the words it carries line up along the right edge.
        -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <!--
        The words a catalogue entry carries, which are the words the tag filter offers.
        They are quieter than the name they sit beside and give way entirely to an
        entry that carries none, so what a type does never competes with what it is
        called.
    -->
    <Style x:Key="Shell.CatalogueEntryTags" TargetType="TextBlock">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding TagLine}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        One chip of the tag filter. It is a toggle read as one: the chip whose word is
        in force is painted in the accent, so which tags are narrowing the catalogue is
        legible without counting the entries that are left.
    -->
    <Style x:Key="Shell.CatalogueTag"
           BasedOn="{StaticResource Shell.ActionButton}"
           TargetType="Button">
        <Setter Property="Margin" Value="0,1,4,1" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        The inspector: what the selection is, the fields its definition declares, and
        the conditions the selection carries. A field and a condition both name what
        they mean in words, so a marked field reads as marked without its colour.
    -->

    <!-- The name of the selected node, which is the one heading the region repeats. -->
    <Style x:Key="Shell.InspectorTitle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--
        A text the user types: the catalogue search and a parameter's value. Both are
        the same control with the same treatment, so a field looks like a field.
    -->
    <Style x:Key="Shell.InputField" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.FocusVisual}" />
    </Style>

    <!-- The label of one parameter. -->
    <Style x:Key="Shell.FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The compact two-column row used by every parameter kind. -->
    <Style x:Key="Shell.ParameterRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <!--
        The condition one field carries. It stays out of the way until there is
        something to say, and it says what it is in words beside the colour.
    -->
    <Style x:Key="Shell.FieldCondition" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="Information">
                <Setter Property="Foreground" Value="{DynamicResource Brush.State.Info}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                <Setter Property="Foreground" Value="{DynamicResource Brush.State.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Error">
                <Setter Property="Foreground" Value="{DynamicResource Brush.State.Danger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- One condition in the inspector's list, coloured by how serious it is. -->
    <Style x:Key="Shell.DiagnosticRow" TargetType="Border">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="Information">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.State.Info}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.State.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Error">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.State.Danger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        A notice that holds back a whole region: the document was opened read-only,
        so the shell says so where the work would have happened.
    -->
    <Style x:Key="Shell.Notice" TargetType="Border">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.State.Warning}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>

    <!--
        The card a question about the document is drawn on. It sits over the work
        surface rather than in a window of its own, so the shell asks without
        leaving itself.
    -->
    <Style x:Key="Shell.PromptCard" TargetType="Border">
        <Setter Property="MaxWidth" Value="460" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
